# HuggingFace API Token (optional but recommended for gated models)
# Get your token from: https://huggingface.co/settings/tokens
VITE_HF_TOKEN=your_huggingface_token_here

# IMPORTANT: For FunctionGemma (google/functiongemma-270m-it), you also need to:
# 1. Visit https://huggingface.co/google/functiongemma-270m-it
# 2. Click "Access repository" and accept the license terms
# 3. Wait for approval (usually instant)
# Without this, the model will fail to load and the app will use regex fallback

# OpenCode Server URL (default: http://localhost:4096)
VITE_OPCODE_URL=http://localhost:4096
